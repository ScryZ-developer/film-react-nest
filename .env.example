# Application
PORT=3000
LOGGER_TYPE=json

# PostgreSQL
POSTGRES_DB=prac
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://localhost:5432/prac
DATABASE_USERNAME=prac
DATABASE_PASSWORD=prac

# Frontend build args (relative paths work behind nginx)
VITE_API_URL=/api/afisha
VITE_CDN_URL=/content/afisha

# Nginx / pgAdmin ports
NGINX_PORT=80
PGADMIN_PORT=8080

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
